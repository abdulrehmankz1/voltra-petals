{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Skill",
      "Agent",
      "WebSearch",
      "WebFetch",
      "ToolSearch",
      "Bash",
      "PowerShell",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(yarn dev)",
      "Bash(yarn build)",
      "Bash(yarn start)",
      "Bash(yarn lint)",
      "Bash(yarn test *)",
      "Bash(yarn tsc --noEmit)",
      "Bash(yarn add *)",
      "Bash(yarn install --frozen-lockfile)",
      "Bash(node scripts/figma.mjs *)",
      "Bash(node scripts/token-report.mjs *)",
      "Bash(node scripts/claude-team/snapshot.mjs *)",
      "Bash(node scripts/claude-team/design-claims.mjs *)",
      "Bash(node --test scripts/claude-team/*.test.mjs)",
      "Bash(python3 scripts/claude-team/validate.py)",
      "Bash(python scripts/claude-team/validate.py)",
      "mcp__figma",
      "mcp__claude_ai_Figma__whoami",
      "mcp__claude_ai_Figma__get_metadata",
      "mcp__claude_ai_Figma__get_screenshot",
      "mcp__claude_ai_Figma__get_design_context",
      "mcp__claude_ai_Figma__get_variable_defs"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(rm -rf / *)",
      "Bash(rm -rf ~ *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(Format-Volume *)",
      "Read(./**/*.xlsx)",
      "Read(./**/*.xls)",
      "Read(./private/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.mjs"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
